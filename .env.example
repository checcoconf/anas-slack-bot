# Solo per provare il job sul tuo PC (su GitHub i valori stanno in Secrets/Variables).
# Uso:  set -a; . ./.env; set +a; python -m anas_bot.job
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_IDS=C0123ABCD
ADMIN_CHANNEL_ID=
# Prova locale senza Cloudflare: il database è un file sul PC
LOCAL_DB_PATH=./prova.sqlite3
# oppure il D1 vero (lo stesso usato dal Worker):
# CF_ACCOUNT_ID=
# CF_D1_DATABASE_ID=
# CF_API_TOKEN=
# facoltativo: numero da cui parte il canale di riserva a numeri (di solito lo fissa l'elenco ufficiale)
ANAS_START_ID=
ANAS_USER_AGENT=WazeItaliaAnasBot/1.0 (+mailto:tuo-indirizzo@example.it)
WELCOME_EXISTING_MEMBERS=true
